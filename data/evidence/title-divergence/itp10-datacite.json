lyName":"Thiemann","affiliation":["University of Innsbruck, Austria"],"contributorType":"Editor","nameIdentifiers":[{"schemeUri":"https://orcid.org","nameIdentifier":"https://orcid.org/0000-0002-0323-8829","nameIdentifierScheme":"ORCID"}]}],"dates":[{"date":"2023","dateType":"Issued"},{"date":"2023-07-26","dateType":"Available"},{"date":"2023-07-26","dateType":"Created"},{"date":"2023-07-26","dateType":"Copyrighted"}],"language":"en","types":{"ris":"CPAPER","bibtex":"inproceedings","citeproc":"","schemaOrg":"Article","resourceTypeGeneral":"ConferencePaper"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"arXiv:2304.08391","resourceTypeGeneral":"Text","relatedIdentifierType":"arXiv"},{"relationType":"IsSupplementedBy","relatedIdentifier":"https://github.com/digama0/mizar-rs/tree/itp2023/itp2023","resourceTypeGeneral":"Software","relatedIdentifierType":"URL"},{"relationType":"IsPartOf","relatedIdentifier":"10.4230/LIPIcs.ITP.2023","relatedIdentifierType":"DOI"},{"relationType":"IsPartOf","relatedIdentifier":"978-3-95977-284-6","relatedIdentifierType":"ISBN"},{"relationType":"IsPartOf","relatedIdentifier":"1868-8969","relatedIdentifierType":"ISSN"},{"relationType":"Cites","relatedIdentifier":"doi:10.2478/forma-2022-0015","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1007/11618027_23","relatedIdentifierType":"DOI"}],"relatedItems":[{"number":"10","titles":[{"title":"LIPIcs, Volume 268, ITP 2023"},{"title":"14th International Conference on Interactive Theorem Proving (ITP 2023)","titleType":"Subtitle"}],"volume":"268","lastPage":"10:18","firstPage":"10:1","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","contributors":[{"name":"Naumowicz, Adam","nameType":"Personal","givenName":"Adam","familyName":"Naumowicz","contributorType":"Editor"},{"name":"Thiemann, René","nameType":"Personal","givenName":"René","familyName":"Thiemann","contributorType":"Editor"}],"relationType":"IsPublishedIn","publicationYear":"2023","relatedItemType":"ConferenceProceeding","relatedItemIdentifier":{"relatedItemIdentifier":"10.4230/LIPIcs.ITP.2023","relatedItemIdentifierType":"DOI"}},{"titles":[{"title":"Leibniz International Proceedings in Informatics (LIPIcs)"}],"volume":"268","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","relationType":"IsPublishedIn","publicationYear":"2023","relatedItemType":"Collection","relatedItemIdentifier":{"relatedItemIdentifier":"1868-8969","relatedItemIdentifierType":"ISSN"}}],"sizes":["18 pages","843279 bytes"],"formats":["application/pdf"],"version":null,"rightsList":[{"lang":"en","rights":"Creative Commons Attribution 4.0 International license","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","rightsIdentifier":"cc by 4.0"},{"rights":"info:eu-repo/semantics/openAccess"}],"descriptions":[{"lang":"en","description":"This paper describes a new open-source proof processing tool, mizar-rs, a wholesale reimplementation of core parts of the Mizar proof system, written in Rust. In particular, the \"checker\" and \"analyzer\" of Mizar are implemented, which together form the trusted core of Mizar. This is to our knowledge the first and only external implementation of these components. Thanks to the loose coupling of Mizar’s passes, it is possible to use the checker as a drop-in replacement for the original, and we have used this to verify the entire MML in 11.8 minutes on 8 cores, a 4.8× speedup over the original Pascal implementation. Since Mizar is not designed to have a small trusted core, checking Mizar proofs entails following Mizar closely, so our ability to detect bugs is limited. Nevertheless, we were able to find multiple memory errors, four soundness bugs in the original (which were not being exploited in MML), in addition to one non-critical bug which was being exploited in 46 different MML articles. We hope to use this checker as a base for proof export tooling, as well as revitalizing development of the language.","descriptionType":"Abstract"},{"lang":"en","description":"LIPIcs, Vol. 268, 14th International Conference on Interactive Theorem Proving (ITP 2023), pages 10:1-10:18","descriptionType":"SeriesInformation"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://drops.dagstuhl.de/entities/document/10.4230/LIPIcs.ITP.2023.10","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2023-07-26T12:46:25.000Z","registered":"2023-07-26T12:46:25.000Z","published":"2023","updated":"2023-12-21T16:01:15.000Z"},"relationships":{"client":{"data":{"id":"lzi.drops","type":"clients"}},"provider":{"data":{"id":"lzi","type":"providers"}},"media":{"data":{"id":"10.4230/lipics.itp.2023.10","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}