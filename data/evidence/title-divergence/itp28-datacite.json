ationType":"Cites","relatedIdentifier":"10.1145/2364527.2364568","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1145/3372885.3373813","relatedIdentifierType":"DOI"}],"relatedItems":[{"number":"28","titles":[{"title":"LIPIcs, Volume 268, ITP 2023"},{"title":"14th International Conference on Interactive Theorem Proving (ITP 2023)","titleType":"Subtitle"}],"volume":"268","lastPage":"28:19","firstPage":"28:1","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","contributors":[{"name":"Naumowicz, Adam","nameType":"Personal","givenName":"Adam","familyName":"Naumowicz","contributorType":"Editor"},{"name":"Thiemann, René","nameType":"Personal","givenName":"René","familyName":"Thiemann","contributorType":"Editor"}],"relationType":"IsPublishedIn","publicationYear":"2023","relatedItemType":"ConferenceProceeding","relatedItemIdentifier":{"relatedItemIdentifier":"10.4230/LIPIcs.ITP.2023","relatedItemIdentifierType":"DOI"}},{"titles":[{"title":"Leibniz International Proceedings in Informatics (LIPIcs)"}],"volume":"268","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","relationType":"IsPublishedIn","publicationYear":"2023","relatedItemType":"Collection","relatedItemIdentifier":{"relatedItemIdentifier":"1868-8969","relatedItemIdentifierType":"ISSN"}}],"sizes":["19 pages","927363 bytes"],"formats":["application/pdf"],"version":null,"rightsList":[{"lang":"en","rights":"Creative Commons Attribution 4.0 International license","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","rightsIdentifier":"cc by 4.0"},{"rights":"info:eu-repo/semantics/openAccess"}],"descriptions":[{"lang":"en","description":"Multiparty session types is a typing discipline used to write specifications, known as global types, for branching and recursive message-passing systems. A necessary operation on global types is projection to abstractions of local behaviour, called local types. Typically, this is a computable partial function that given a global type and a role erases all details irrelevant to this role.\r\nComputable projection functions in the literature are either unsound or too restrictive when dealing with recursion and branching. Recent work has taken a more general approach to projection defining it as a coinductive, but not computable, relation. Our work defines a new computable projection function that is sound and complete with respect to its coinductive counterpart and, hence, equally expressive. All results have been mechanised in the Coq proof assistant.","descriptionType":"Abstract"},{"lang":"en","description":"LIPIcs, Vol. 268, 14th International Conference on Interactive Theorem Proving (ITP 2023), pages 28:1-28:19","descriptionType":"SeriesInformation"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://drops.dagstuhl.de/entities/document/10.4230/LIPIcs.ITP.2023.28","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":6,"citationsOverTime":[{"year":"2024","total":1},{"year":"2025","total":4},{"year":"2026","total":1}],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2023-07-26T12:48:04.000Z","registered":"2023-07-26T12:48:09.000Z","published":"2023","updated":"2024-09-02T10:07:13.000Z"},"relationships":{"client":{"data":{"id":"lzi.drops","type":"clients"}},"provider":{"data":{"id":"lzi","type":"providers"}},"media":{"data":{"id":"10.4230/lipics.itp.2023.28","type":"media"}},"references":{"data":[]},"citations":{"data":[{"id":"10.4230/lipics.itp.2024.13","type":"dois"},{"id":"10.4230/lipics.ecoop.2025.31","type":"dois"},{"id":"10.4230/lipics.itp.2025.11","type":"dois"},{"id":"10.4230/lipics.itp.2025.15","type":"dois"},{"id":"10.4230/lipics.itp.2025.19","type":"dois"},{"id":"10.4230/lipics.itp.2026.4","type":"dois"}]},"parts":{"da