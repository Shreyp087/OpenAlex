6569.3392375","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1007/978-3-030-32409-4_6","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1016/0364-0213(94)90021-3","relatedIdentifierType":"DOI"}],"relatedItems":[{"number":"24","titles":[{"title":"LIPIcs, Volume 268, ITP 2023"},{"title":"14th International Conference on Interactive Theorem Proving (ITP 2023)","titleType":"Subtitle"}],"volume":"268","lastPage":"24:20","firstPage":"24:1","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","contributors":[{"name":"Naumowicz, Adam","nameType":"Personal","givenName":"Adam","familyName":"Naumowicz","contributorType":"Editor"},{"name":"Thiemann, René","nameType":"Personal","givenName":"René","familyName":"Thiemann","contributorType":"Editor"}],"relationType":"IsPublishedIn","publicationYear":"2023","relatedItemType":"ConferenceProceeding","relatedItemIdentifier":{"relatedItemIdentifier":"10.4230/LIPIcs.ITP.2023","relatedItemIdentifierType":"DOI"}},{"titles":[{"title":"Leibniz International Proceedings in Informatics (LIPIcs)"}],"volume":"268","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","relationType":"IsPublishedIn","publicationYear":"2023","relatedItemType":"Collection","relatedItemIdentifier":{"relatedItemIdentifier":"1868-8969","relatedItemIdentifierType":"ISSN"}}],"sizes":["20 pages","1531949 bytes"],"formats":["application/pdf"],"version":null,"rightsList":[{"lang":"en","rights":"Creative Commons Attribution 4.0 International license","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","rightsIdentifier":"cc by 4.0"},{"rights":"info:eu-repo/semantics/openAccess"}],"descriptions":[{"lang":"en","description":"Contemporary proof assistants rely on complex automation and process libraries with millions of lines of code. At these scales, understanding the emergent interactions between components can be a serious challenge. One way of managing complexity, long established in informal practice, is through varying external representations. For instance, algebraic notation facilitates term-based reasoning whereas geometric diagrams invoke spatial intuition. Objects viewed one way become much simpler than when viewed differently. In contrast, modern general-purpose ITP systems usually only support limited, textual representations. Treating this as a problem of human-computer interaction, we aim to demonstrate that presentations - UI elements that store references to the objects they are displaying - are a fruitful way of thinking about ITP interface design. They allow us to make headway on two fronts - introspection of prover internals and support for diagrammatic reasoning. To this end we have built an extensible user interface for the Lean 4 prover with an associated ProofWidgets 4 library of presentation-based UI components. We demonstrate the system with several examples including type information popups, structured traces, contextual suggestions, a display for algebraic reasoning, and visualizations of red-black trees. Our interface is already part of the core Lean distribution.","descriptionType":"Abstract"},{"lang":"en","description":"LIPIcs, Vol. 268, 14th International Conference on Interactive Theorem Proving (ITP 2023), pages 24:1-24:20","descriptionType":"SeriesInformation"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://drops.dagstuhl.de/entities/document/10.4230/LIPIcs.ITP.2023.24","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":4,"citationsOverTime":[{"year":"2024","total":2},{"year":"2025","total":1},{"year":"2026","total":1}],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2023-07-26T12:47:57.000Z","registered":"2023-07-26T12:48:07.000Z","published":"2023"