"nameIdentifiers":[{"schemeUri":"https://orcid.org","nameIdentifier":"https://orcid.org/0000-0002-0323-8829","nameIdentifierScheme":"ORCID"}]}],"dates":[{"date":"2023","dateType":"Issued"},{"date":"2023-07-26","dateType":"Available"},{"date":"2023-07-26","dateType":"Created"},{"date":"2023-07-26","dateType":"Copyrighted"}],"language":"en","types":{"ris":"CPAPER","bibtex":"inproceedings","citeproc":"","schemaOrg":"Article","resourceTypeGeneral":"ConferencePaper"},"relatedIdentifiers":[{"relationType":"IsSupplementedBy","relatedIdentifier":"https://github.com/urbanchr/posix","resourceTypeGeneral":"Software","relatedIdentifierType":"URL"},{"relationType":"IsPartOf","relatedIdentifier":"10.4230/LIPIcs.ITP.2023","relatedIdentifierType":"DOI"},{"relationType":"IsPartOf","relatedIdentifier":"978-3-95977-284-6","relatedIdentifierType":"ISBN"},{"relationType":"IsPartOf","relatedIdentifier":"1868-8969","relatedIdentifierType":"ISSN"},{"relationType":"Cites","relatedIdentifier":"https://wiki.haskell.org/Regex_Posix","relatedIdentifierType":"URL"},{"relationType":"Cites","relatedIdentifier":"http://pubs.opengroup.org/onlinepubs/009695399/basedefs/xbd_chap09.html","relatedIdentifierType":"URL"}],"relatedItems":[{"number":"27","titles":[{"title":"LIPIcs, Volume 268, ITP 2023"},{"title":"14th International Conference on Interactive Theorem Proving (ITP 2023)","titleType":"Subtitle"}],"volume":"268","lastPage":"27:18","firstPage":"27:1","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","contributors":[{"name":"Naumowicz, Adam","nameType":"Personal","givenName":"Adam","familyName":"Naumowicz","contributorType":"Editor"},{"name":"Thiemann, René","nameType":"Personal","givenName":"René","familyName":"Thiemann","contributorType":"Editor"}],"relationType":"IsPublishedIn","publicationYear":"2023","relatedItemType":"ConferenceProceeding","relatedItemIdentifier":{"relatedItemIdentifier":"10.4230/LIPIcs.ITP.2023","relatedItemIdentifierType":"DOI"}},{"titles":[{"title":"Leibniz International Proceedings in Informatics (LIPIcs)"}],"volume":"268","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","relationType":"IsPublishedIn","publicationYear":"2023","relatedItemType":"Collection","relatedItemIdentifier":{"relatedItemIdentifier":"1868-8969","relatedItemIdentifierType":"ISSN"}}],"sizes":["18 pages","742828 bytes"],"formats":["application/pdf"],"version":null,"rightsList":[{"lang":"en","rights":"Creative Commons Attribution 4.0 International license","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","rightsIdentifier":"cc by 4.0"},{"rights":"info:eu-repo/semantics/openAccess"}],"descriptions":[{"lang":"en","description":"Sulzmann and Lu describe a lexing algorithm that calculates Brzozowski derivatives using bitcodes annotated to regular expressions. Their algorithm generates POSIX values which encode the information of how a regular expression matches a string - that is, which part of the string is matched by which part of the regular expression. This information is needed in the context of lexing in order to extract and to classify tokens. The purpose of the bitcodes is to generate POSIX values incrementally while derivatives are calculated. They also help with designing an \"aggressive\" simplification function that keeps the size of derivatives finitely bounded. Without simplification the size of some derivatives can grow arbitrarily big, resulting in an extremely slow lexing algorithm. In this paper we describe a variant of Sulzmann and Lu’s algorithm: Our variant is a recursive functional program, whereas Sulzmann and Lu’s version involves a fixpoint construction. We (i) prove in Isabelle/HOL that our variant is correct and generates unique POSIX values (no such proof has been given for the original algorithm by Sulzmann and Lu); we also (ii) establish finite bounds for the size of our derivatives.","descriptionType":"Abstract"},{"lang":"en","description":"LIPIcs, Vol. 268, 14th International Conference on Interactive Theorem Proving (ITP 2023), pages 27:1-27:18","descriptionType":"SeriesInformation"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://drops.dagstuhl.de/entities/document/10.4230/LIPIcs.ITP.2023.27","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":1,"citationsOverTime":[{"year":"2025","total":1}],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2023-07-26T12:48:04.000Z","registered":"2023-07-26T12:48:04.000Z","published":"2023","updated":"2023-12-21T16:01:27.000Z"},"relationships":{"client":{"data":{"id":"lzi.drops","type":"clients"}},"provider":{"data":{"id":"lzi","type":"providers"}},"media":{"data":{"id":"10.4230/lipics.itp.2023.27","type":"media"}},"references":{"data":[]},"citations":{"data":[{"id":"10.4230/lipics.itp.2025.16","type":"dois"}]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}