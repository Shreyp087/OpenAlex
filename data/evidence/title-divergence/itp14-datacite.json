7/S0956796807006326","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1145/53990.54010","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1145/3426425.3426940","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1016/S0890-5401(03)00138-X","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"https://web.archive.org/web/20101122040606/http://homepages.inf.ed.ac.uk/rpollack/export/bindingChallenge_slides.pdf","relatedIdentifierType":"URL"},{"relationType":"Cites","relatedIdentifier":"https://github.com/coq-community/dblib","relatedIdentifierType":"URL"},{"relationType":"Cites","relatedIdentifier":"10.1007/978-3-319-22102-1_24","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1145/1291151.1291155","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1007/978-3-540-71067-7_23","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1017/S0960129511000119","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1145/3293880.3294101","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1007/11532231_4","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1145/143165.143169","relatedIdentifierType":"DOI"}],"relatedItems":[{"number":"14","titles":[{"title":"LIPIcs, Volume 268, ITP 2023"},{"title":"14th International Conference on Interactive Theorem Proving (ITP 2023)","titleType":"Subtitle"}],"volume":"268","lastPage":"14:20","firstPage":"14:1","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","contributors":[{"name":"Naumowicz, Adam","nameType":"Personal","givenName":"Adam","familyName":"Naumowicz","contributorType":"Editor"},{"name":"Thiemann, René","nameType":"Personal","givenName":"René","familyName":"Thiemann","contributorType":"Editor"}],"relationType":"IsPublishedIn","publicationYear":"2023","relatedItemType":"ConferenceProceeding","relatedItemIdentifier":{"relatedItemIdentifier":"10.4230/LIPIcs.ITP.2023","relatedItemIdentifierType":"DOI"}},{"titles":[{"title":"Leibniz International Proceedings in Informatics (LIPIcs)"}],"volume":"268","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","relationType":"IsPublishedIn","publicationYear":"2023","relatedItemType":"Collection","relatedItemIdentifier":{"relatedItemIdentifier":"1868-8969","relatedItemIdentifierType":"ISSN"}}],"sizes":["20 pages","1123003 bytes"],"formats":["application/pdf"],"version":null,"rightsList":[{"lang":"en","rights":"Creative Commons Attribution 4.0 International license","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","rightsIdentifier":"cc by 4.0"},{"rights":"info:eu-repo/semantics/openAccess"}],"descriptions":[{"lang":"en","description":"Verifying the metatheory of a formal system in Coq involves a lot of tedious \"infrastructural\" reasoning about variable binders. We present Tealeaves, a generic framework for first-order representations of variable binding that can be used to develop this sort of infrastructure once and for all. Given a particular strategy for representing binders concretely, such as locally nameless or de Bruijn indices, Tealeaves allows developers to implement modules of generic infrastructure called backends that end users can simply instantiate to their own syntax. Our framework rests on a novel abstraction of first-order abstract syntax called a decorated traversable monad (DTM) whose equational theory provides reasoning principles that replace tedious induction on terms. To evaluate Tealeaves, we have implemented a multisorted locally nameless backend providing generic versions of the lemmas generated by LNgen. We discuss case studies where we instantiate this generic infrastructure to simply-typed and polymorphic lambda calculi, comparing our approach to other utilities.","descriptionType":"Abstract"},{"lang":"en","description":"LIPIcs, Vol. 268, 14th International Conference on Interactive Theorem Proving (ITP 2023), pages 14:1-14:20","descriptionType":"SeriesInformation"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://drops.dagstuhl.de/entities/document/10.4230/LIPIcs.ITP.2023.14","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2023-07-26T12:46:26.000Z","registered":"2023-07-26T12:46:26.000Z","published":"2023","updated":"2023-12-21T16:01:18.000Z"},"relationships":{"client":{"data":{"id":"lzi.drops","type":"clients"}},"provider":{"data":{"id":"lzi","type":"providers"}},"media":{"data":{"id":"10.4230/lipics.itp.2023.14","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}