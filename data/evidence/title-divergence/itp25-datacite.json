dBy","relatedIdentifier":"https://github.com/pPomCo/belgames","resourceTypeGeneral":"Software","relatedIdentifierType":"URL"},{"relationType":"IsPartOf","relatedIdentifier":"10.4230/LIPIcs.ITP.2023","relatedIdentifierType":"DOI"},{"relationType":"IsPartOf","relatedIdentifier":"978-3-95977-284-6","relatedIdentifierType":"ISBN"},{"relationType":"IsPartOf","relatedIdentifier":"1868-8969","relatedIdentifierType":"ISSN"},{"relationType":"Cites","relatedIdentifier":"arXiv:2209.02345","relatedIdentifierType":"arXiv"},{"relationType":"Cites","relatedIdentifier":"10.1007/s10817-019-09538-8","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1007/s10817-021-09612-0","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.5281/zenodo.1003420","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"https://www.isa-afp.org/browser_info/devel/AFP/Parity_Game/outline.pdf","relatedIdentifierType":"URL"},{"relationType":"Cites","relatedIdentifier":"10.1007/978-3-030-86772-0_24","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.4204/EPTCS.256.4","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.5281/zenodo.7118596","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"https://staff.aist.go.jp/reynald.affeldt/coq2019/coqws2019-martindorel-tassi.pdf","relatedIdentifierType":"URL"},{"relationType":"Cites","relatedIdentifier":"10.1016/j.ijar.2022.09.010","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1007/978-3-642-03359-9_21","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1016/j.ipl.2005.09.010","relatedIdentifierType":"DOI"}],"relatedItems":[{"number":"25","titles":[{"title":"LIPIcs, Volume 268, ITP 2023"},{"title":"14th International Conference on Interactive Theorem Proving (ITP 2023)","titleType":"Subtitle"}],"volume":"268","lastPage":"25:19","firstPage":"25:1","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","contributors":[{"name":"Naumowicz, Adam","nameType":"Personal","givenName":"Adam","familyName":"Naumowicz","contributorType":"Editor"},{"name":"Thiemann, René","nameType":"Personal","givenName":"René","familyName":"Thiemann","contributorType":"Editor"}],"relationType":"IsPublishedIn","publicationYear":"2023","relatedItemType":"ConferenceProceeding","relatedItemIdentifier":{"relatedItemIdentifier":"10.4230/LIPIcs.ITP.2023","relatedItemIdentifierType":"DOI"}},{"titles":[{"title":"Leibniz International Proceedings in Informatics (LIPIcs)"}],"volume":"268","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","relationType":"IsPublishedIn","publicationYear":"2023","relatedItemType":"Collection","relatedItemIdentifier":{"relatedItemIdentifier":"1868-8969","relatedItemIdentifierType":"ISSN"}}],"sizes":["19 pages","967913 bytes"],"formats":["application/pdf"],"version":null,"rightsList":[{"lang":"en","rights":"Creative Commons Attribution 4.0 International license","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","rightsIdentifier":"cc by 4.0"},{"rights":"info:eu-repo/semantics/openAccess"}],"descriptions":[{"lang":"en","description":"Decision theory and game theory are both interdisciplinary domains that focus on modelling and {analyzing} decision-making processes. On the one hand, decision theory aims to account for the possible behaviors of an agent with respect to an uncertain situation. It thus provides several frameworks to describe the decision-making processes in this context, including that of belief functions. On the other hand, game theory focuses on multi-agent decisions, typically with probabilistic uncertainty (if any), hence the so-called class of Bayesian games. In this paper, we use the Coq/SSReflect proof assistant to formally prove the results we obtained in [Pierre Pomeret{-}Coquot et al., 2022]. First, we formalize a general theory of belief functions with finite support, and structures and solutions concepts from game theory. On top of that, we extend Bayesian games to the theory of belief functions, so that we obtain a more expressive class of games we refer to as Bel games; it makes it possible to better capture human behaviors with respect to lack of information. Next, we provide three different proofs of an extended version of the so-called Howson-Rosenthal’s theorem, showing that Bel games can be casted into games of complete information, i.e., without any uncertainty. We thus embed this class of games into classical game theory, enabling the use of existing algorithms.","descriptionType":"Abstract"},{"lang":"en","description":"LIPIcs, Vol. 268, 14th International Conference on Interactive Theorem Proving (ITP 2023), pages 25:1-25:19","descriptionType":"SeriesInformation"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://drops.dagstuhl.de/entities/document/10.4230/LIPIcs.ITP.2023.25","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":9,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":1,"versionCount":0,"versionOfCount":1,"created":"2023-07-26T12:47:58.000Z","registered":"2023-07-26T12:47:58.000Z","published":"2023","updated":"2025-05-28T02:41:33.000Z"},"relationships":{"client":{"data":{"id":"lzi.drops","type":"clients"}},"provider":{"data":{"id":"lzi","type":"providers"}},"media":{"data":{"id":"10.4230/lipics.itp.2023.25","type":"media"}},"references":{"data":[{"id":"10.1007/s10817-019-09538-8","type":"dois"},{"id":"10.1007/s10817-021-09612-0","type":"dois"},{"id":"10.5281/zenodo.1003420","type":"dois"},{"id":"10.1007/978-3-030-86772-0_24","type":"dois"},{"id":"10.4204/eptcs.256.4","type":"dois"},{"id":"10.5281/zenodo.7118596","type":"dois"},{"id":"10.1016/j.ijar.2022.09.010","type":"dois"},{"id