nType":"Cites","relatedIdentifier":"10.1070/rm1986v041n06abeh004237","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"https://homotopytypetheory.org/book","relatedIdentifierType":"URL"},{"relationType":"Cites","relatedIdentifier":"10.48550/arXiv.1808.10690","relatedIdentifierType":"DOI"}],"relatedItems":[{"number":"16","titles":[{"title":"LIPIcs, Volume 268, ITP 2023"},{"title":"14th International Conference on Interactive Theorem Proving (ITP 2023)","titleType":"Subtitle"}],"volume":"268","lastPage":"16:17","firstPage":"16:1","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","contributors":[{"name":"Naumowicz, Adam","nameType":"Personal","givenName":"Adam","familyName":"Naumowicz","contributorType":"Editor"},{"name":"Thiemann, René","nameType":"Personal","givenName":"René","familyName":"Thiemann","contributorType":"Editor"}],"relationType":"IsPublishedIn","publicationYear":"2023","relatedItemType":"ConferenceProceeding","relatedItemIdentifier":{"relatedItemIdentifier":"10.4230/LIPIcs.ITP.2023","relatedItemIdentifierType":"DOI"}},{"titles":[{"title":"Leibniz International Proceedings in Informatics (LIPIcs)"}],"volume":"268","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","relationType":"IsPublishedIn","publicationYear":"2023","relatedItemType":"Collection","relatedItemIdentifier":{"relatedItemIdentifier":"1868-8969","relatedItemIdentifierType":"ISSN"}}],"sizes":["17 pages","837968 bytes"],"formats":["application/pdf"],"version":null,"rightsList":[{"lang":"en","rights":"Creative Commons Attribution 4.0 International license","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","rightsIdentifier":"cc by 4.0"},{"rights":"info:eu-repo/semantics/openAccess"}],"descriptions":[{"lang":"en","description":"Ext groups are fundamental objects from homological algebra which underlie important computations in homotopy theory. We formalise the theory of Yoneda Ext groups [Yoneda, 1954] in homotopy type theory (HoTT) using the Coq-HoTT library. This is an approach to Ext which does not require projective or injective resolutions, though it produces large abelian groups. Using univalence, we show how these Ext groups can be naturally represented in HoTT. We give a novel proof and formalisation of the usual six-term exact sequence via a fibre sequence of 1-types (or groupoids), along with an application. In addition, we discuss our formalisation of the contravariant long exact sequence of Ext, an important computational tool. Along the way we implement and explain the Baer sum of extensions and how Ext is a bifunctor.","descriptionType":"Abstract"},{"lang":"en","description":"LIPIcs, Vol. 268, 14th International Conference on Interactive Theorem Proving (ITP 2023), pages 16:1-16:17","descriptionType":"SeriesInformation"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://drops.dagstuhl.de/entities/document/10.4230/LIPIcs.ITP.2023.16","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2023-07-26T12:46:26.000Z","registered":"2023-07-26T12:46:29.000Z","published":"2023","updated":"2023-12-21T16:01:20.000Z"},"relationships":{"client":{"data":{"id":"lzi.drops","type":"clients"}},"provider":{"data":{"id":"lzi","type":"providers"}},"media":{"data":{"id":"10.4230/lipics.itp.2023.16","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}