"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1215/S0012-7094-36-00227-2","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1090/S0002-9947-1943-0007371-8","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1007/978-3-319-66107-0_24","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.46298/lmcs-18(1:35)2022","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1142/9789811236488_0008","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"http://kar.kent.ac.uk/21524/","relatedIdentifierType":"URL"}],"relatedItems":[{"number":"21","titles":[{"title":"LIPIcs, Volume 268, ITP 2023"},{"title":"14th International Conference on Interactive Theorem Proving (ITP 2023)","titleType":"Subtitle"}],"volume":"268","lastPage":"21:17","firstPage":"21:1","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","contributors":[{"name":"Naumowicz, Adam","nameType":"Personal","givenName":"Adam","familyName":"Naumowicz","contributorType":"Editor"},{"name":"Thiemann, René","nameType":"Personal","givenName":"René","familyName":"Thiemann","contributorType":"Editor"}],"relationType":"IsPublishedIn","publicationYear":"2023","relatedItemType":"ConferenceProceeding","relatedItemIdentifier":{"relatedItemIdentifier":"10.4230/LIPIcs.ITP.2023","relatedItemIdentifierType":"DOI"}},{"titles":[{"title":"Leibniz International Proceedings in Informatics (LIPIcs)"}],"volume":"268","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","relationType":"IsPublishedIn","publicationYear":"2023","relatedItemType":"Collection","relatedItemIdentifier":{"relatedItemIdentifier":"1868-8969","relatedItemIdentifierType":"ISSN"}}],"sizes":["17 pages","689300 bytes"],"formats":["application/pdf"],"version":null,"rightsList":[{"lang":"en","rights":"Creative Commons Attribution 4.0 International license","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","rightsIdentifier":"cc by 4.0"},{"rights":"info:eu-repo/semantics/openAccess"}],"descriptions":[{"lang":"en","description":"Basing on an original Coq implementation of unbounded linear search for partially decidable predicates, we study the computational contents of μ-recursive functions via their syntactic representation, and a correct by construction Coq interpreter for this abstract syntax. When this interpreter is extracted, we claim the resulting OCaml code to be the natural combination of the implementation of the μ-recursive schemes of composition, primitive recursion and unbounded minimization of partial (i.e., possibly non-terminating) functions. At the level of the fully specified Coq terms, this implies the representation of higher-order functions of which some of the arguments are themselves partial functions. We handle this issue using some techniques coming from the Braga method. Hence we get a faithful embedding of μ-recursive algorithms into Coq preserving not only their extensional meaning but also their intended computational behavior. We put a strong focus on the quality of the Coq artifact which is both self contained and with a line of code count of less than 1k in total.","descriptionType":"Abstract"},{"lang":"en","description":"LIPIcs, Vol. 268, 14th International Conference on Interactive Theorem Proving (ITP 2023), pages 21:1-21:17","descriptionType":"SeriesInformation"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://drops.dagstuhl.de/entities/document/10.4230/LIPIcs.ITP.2023.21","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2023-07-26T12:47:14.000Z","registered":"2023-07-26T12:47:14.000Z","published":"