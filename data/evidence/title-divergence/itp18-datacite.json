latedIdentifier":"10.1145/3018610.3018628","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1145/1982185.1982529","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1007/978-3-662-49498-1_20","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1145/3497775.3503674","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1145/3571235","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"http://adriansampson.net/doc/ppl.html","relatedIdentifierType":"URL"},{"relationType":"Cites","relatedIdentifier":"10.1145/3290351","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1145/3158148","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1007/b98956","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1017/9781108770750.003","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"arXiv:2007.06776","relatedIdentifierType":"arXiv"},{"relationType":"Cites","relatedIdentifier":"10.1145/3290349","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.48550/ARXIV.1810.01837","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"https://alfa.di.uminho.pt/~nevrenato/probprogschool_slides/Hongseok.pdf","relatedIdentifierType":"URL"},{"relationType":"Cites","relatedIdentifier":"10.1145/3498677","relatedIdentifierType":"DOI"}],"relatedItems":[{"number":"18","titles":[{"title":"LIPIcs, Volume 268, ITP 2023"},{"title":"14th International Conference on Interactive Theorem Proving (ITP 2023)","titleType":"Subtitle"}],"volume":"268","lastPage":"18:18","firstPage":"18:1","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","contributors":[{"name":"Naumowicz, Adam","nameType":"Personal","givenName":"Adam","familyName":"Naumowicz","contributorType":"Editor"},{"name":"Thiemann, René","nameType":"Personal","givenName":"René","familyName":"Thiemann","contributorType":"Editor"}],"relationType":"IsPublishedIn","publicationYear":"2023","relatedItemType":"ConferenceProceeding","relatedItemIdentifier":{"relatedItemIdentifier":"10.4230/LIPIcs.ITP.2023","relatedItemIdentifierType":"DOI"}},{"titles":[{"title":"Leibniz International Proceedings in Informatics (LIPIcs)"}],"volume":"268","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","relationType":"IsPublishedIn","publicationYear":"2023","relatedItemType":"Collection","relatedItemIdentifier":{"relatedItemIdentifier":"1868-8969","relatedItemIdentifierType":"ISSN"}}],"sizes":["18 pages","857894 bytes"],"formats":["application/pdf"],"version":null,"rightsList":[{"lang":"en","rights":"Creative Commons Attribution 4.0 International license","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","rightsIdentifier":"cc by 4.0"},{"rights":"info:eu-repo/semantics/openAccess"}],"descriptions":[{"lang":"en","description":"Higher-order probabilistic programs are used to describe statistical models and machine-learning mechanisms. The programming languages for them are equipped with three features: higher-order functions, sampling, and conditioning. In this paper, we propose an Isabelle/HOL library for probabilistic programs supporting all of those three features. We extend our previous quasi-Borel theory library in Isabelle/HOL. As a basis of the theory, we formalize s-finite kernels, which is considered as a theoretical foundation of first-order probabilistic programs and a key to support conditioning of probabilistic programs. We also formalize the Borel isomorphism theorem which plays an important role in the quasi-Borel theory. Using them, we develop the s-finite measure monad on quasi-Borel spaces. Our extension enables us to describe higher-order probabilistic programs with conditioning directly as an Isabelle/HOL term whose type is that of morphisms between quasi-Borel spaces. We also implement the qbs prover for checking well-typedness of an Isabelle/HOL term as a morphism between quasi-Borel spaces. We demonstrate several verification examples of higher-order probabilistic programs with conditioning.","descriptionType":"Abstract"},{"lang":"en","description":"LIPIcs, Vol. 268, 14th International Conference on Interactive Theorem Proving (ITP 2023), pages 18:1-18:18","descriptionType":"SeriesInformation"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://drops.dagstuhl.de/entities/document/10.4230/LIPIcs.ITP.2023.18","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":1,"citationsOverTime":[{"year":"2024","total":1}],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2023-07-26T12:47:13.000Z","registered":"2023-07-26T12:47:13.000Z","published":"2023","updated":"2025-05-28T02:10:16.000Z"},"relationships":{"client":{"data":{"id":"lzi.drops","type":"clients"}},"provider":{"data":{"id":"lzi","type":"providers"}},"media":{"data":{"id":"10.4230/lipics.itp.2023.18","type":"media"}},"references":{"data":[]},"citations":{"data":[{"id":"10.4230/lipics.itp.2024.21","type":"dois"}]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}