tes","relatedIdentifier":"10.3102/0034654315581420","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1109/ISEC61299.2024.10665141","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1037/a0037123","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.48550/arXiv.2410.10650","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1007/978-3-032-03870-8_28","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.48550/arXiv.2509.03269","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.48550/arXiv.2402.07927","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.3233/JAI-2010-0005","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.1080/00461520.2011.611369","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"arXiv:1706.03762","relatedIdentifierType":"arXiv"},{"relationType":"Cites","relatedIdentifier":"10.1038/s41598-025-07422-7","relatedIdentifierType":"DOI"}],"relatedItems":[{"number":"2","titles":[{"title":"OASIcs, Volume 145, ICPEC 2026"},{"title":"7th International Computer Programming Education Conference (ICPEC 2026)","titleType":"Subtitle"}],"volume":"145","lastPage":"2:14","firstPage":"2:1","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","contributors":[{"name":"Portela, Filipe","nameType":"Personal","givenName":"Filipe","familyName":"Portela","contributorType":"Editor"},{"name":"Matos, Luís","nameType":"Personal","givenName":"Luís","familyName":"Matos","contributorType":"Editor"},{"name":"Guimarães, Tiago","nameType":"Personal","givenName":"Tiago","familyName":"Guimarães","contributorType":"Editor"}],"relationType":"IsPublishedIn","publicationYear":"2026","relatedItemType":"ConferenceProceeding","relatedItemIdentifier":{"relatedItemIdentifier":"10.4230/OASIcs.ICPEC.2026","relatedItemIdentifierType":"DOI"}},{"titles":[{"title":"Open Access Series in Informatics (OASIcs)"}],"volume":"145","publisher":"Schloss Dagstuhl – Leibniz-Zentrum für Informatik","relationType":"IsPublishedIn","publicationYear":"2026","relatedItemType":"Collection","relatedItemIdentifier":{"relatedItemIdentifier":"2190-6807","relatedItemIdentifierType":"ISSN"}}],"sizes":["14 pages","1472022 bytes"],"formats":["application/pdf"],"version":null,"rightsList":[{"lang":"en","rights":"Creative Commons Attribution 4.0 International license","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","rightsIdentifier":"cc by 4.0"},{"rights":"info:eu-repo/semantics/openAccess"}],"descriptions":[{"lang":"en","description":"The research described in this paper explores the integration of Generative Artificial Intelligence (GenAI) into Intelligent Tutoring Systems (ITS) with the aim of improving programming education. Specifically, it extends Agni, a web-based programming learning platform, by automating the construction of key ITS components that are traditionally built manually. The methodology leverages Large Language Models (LLMs) to extract programming concepts from educational materials, map their relationships via concept graphs and diagnose specific student knowledge gaps. Additionally, GenAI provides real-time, contextual feedback during programming exercises, mimicking the personalized support typically offered by a human tutor. The work evaluates whether GenAI can effectively replace or augment the manual creation of domain models while preserving the pedagogical benefits of ITS. The obtained results suggest the potential of combining AI with ITS to improve scalability and reduce manual workload.","descriptionType":"Abstract"},{"lang":"en","description":"OASIcs, Vol. 145, 7th International Computer Programming Education Conference (ICPEC 2026), pages 2:1-2:14","descriptionType":"SeriesInformation"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://drops.dagstuhl.de/entities/docum